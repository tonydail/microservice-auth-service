// This file is generated by Prisma — run `npm run db:generate` to regenerate.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)
}

// Transactional Outbox — written inside Prisma transactions alongside domain changes.
// Debezium reads this table via WAL (pgoutput) and publishes to Kafka.
// Never write to this table outside of a $transaction block.
model OutboxEvent {
  id          String   @id @default(uuid())
  aggregateId String
  eventType   String
  payload     Json
  createdAt   DateTime @default(now())

  @@map("outbox_events")
}
